function deleteLegacyJulAugSepData() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const operatorEmail = Session.getActiveUser().getEmail() || '未知';
  const timestamp = Utilities.formatDate(new Date(), Session.getScriptTimeZone(), "yyyy-MM-dd HH:mm:ss");

  // 把 [场地, 单位, 使用日期] 组成查找集合，等一下逐行比对时要跟「填写人=历史资料导入」同时成立才删除
  const importSet = new Set(LEGACY_IMPORT_DATA_FOR_DELETE.map(function(e) { return e[0] + '|' + e[1] + '|' + e[2]; }));

  const monthKeys = ['2026-07', '2026-08', '2026-09'];
  let totalDeleted = 0;
  const summaryLines = [];

  monthKeys.forEach(function(monthKey) {
    const sheet = ss.getSheetByName(monthKey);
    if (!sheet) { summaryLines.push(monthKey + '：找不到这个工作表，跳过'); return; }
    const lastRow = sheet.getLastRow();
    if (lastRow <= 1) { summaryLines.push(monthKey + '：0 笔（表是空的）'); return; }
    const lastCol = sheet.getLastColumn();
    const data = sheet.getRange(1, 1, lastRow, lastCol).getValues();
    const headers = data[0];
    const venueIdx = headers.indexOf('场地');
    const unitIdx = headers.indexOf('单位');
    const fillerIdx = headers.indexOf('填写人');
    const useDateIdx = headers.indexOf('使用日期');

    if (venueIdx === -1 || unitIdx === -1 || fillerIdx === -1 || useDateIdx === -1) {
      summaryLines.push(monthKey + '：栏位对不上 HEADERS，跳过（可能不是借用记录表）');
      return;
    }

    const rowsToKeep = [data[0]]; // 保留表头
    let deletedCount = 0;
    for (let i = 1; i < data.length; i++) {
      const row = data[i];
      const filler = String(row[fillerIdx] || '');
      const useDateISO = normalizeDateToISO(row[useDateIdx]);
      const key = String(row[venueIdx] || '') + '|' + String(row[unitIdx] || '') + '|' + useDateISO;
      const isLegacyImportRow = (filler === '历史资料导入') && importSet.has(key);
      if (isLegacyImportRow) {
        deletedCount++;
      } else {
        rowsToKeep.push(row);
      }
    }

    if (deletedCount > 0) {
      // 整张表清空重写：只留表头 + 没被命中的行，比逐行 deleteRow 好几百次快很多
      sheet.clearContents();
      sheet.getRange(1, 1, rowsToKeep.length, headers.length).setValues(rowsToKeep);
      sheet.setFrozenRows(1);
      sheet.getRange(1, 1, 1, headers.length).setFontWeight("bold");
      // clearContents 不会动到栏位格式，但保险起见还是把时间栏位纯文本格式补回去
      const startCol = headers.indexOf('时间(开始)') + 1;
      const endCol = headers.indexOf('时间(结束)') + 1;
      if (startCol > 0 && endCol > 0) {
        sheet.getRange(1, startCol, sheet.getMaxRows(), 2).setNumberFormat('@');
      }
    }

    totalDeleted += deletedCount;
    summaryLines.push(monthKey + '：删除 ' + deletedCount + ' 笔（保留 ' + (rowsToKeep.length - 1) + ' 笔其他记录）');
    Logger.log(monthKey + ' 删除 ' + deletedCount + ' 笔');
  });

  // 写一笔汇总操作日志，不逐行记录
  try {
    let auditSheet = ss.getSheetByName(AUDIT_SHEET_NAME);
    if (!auditSheet) {
      auditSheet = ss.insertSheet(AUDIT_SHEET_NAME);
      auditSheet.appendRow(['时间', '操作类型', '操作人邮箱', '记录ID', '场地', '活动', '单位', '时间段']);
      auditSheet.setFrozenRows(1);
      auditSheet.getRange("A1:H1").setFontWeight("bold");
    }
    auditSheet.appendRow([
      timestamp, '批量删除历史资料导入', operatorEmail, '(批量删除 ' + totalDeleted + ' 笔)',
      '2026-07~09 联课团体场地', '联课团体例常活动', '(见各笔记录)', summaryLines.join('，')
    ]);
  } catch (e) {
    Logger.log('写入操作日志失败: ' + e.message);
  }

  Logger.log('✅ 删除完成，共删除 ' + totalDeleted + ' 笔：' + summaryLines.join('，'));
  return { success: true, totalDeleted: totalDeleted, summary: summaryLines };
}
