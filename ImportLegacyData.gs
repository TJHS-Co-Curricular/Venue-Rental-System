function importLegacyJulAugSepData() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const operatorEmail = Session.getActiveUser().getEmail() || '未知';
  const timestamp = Utilities.formatDate(new Date(), Session.getScriptTimeZone(), "yyyy-MM-dd HH:mm:ss");
  const todayStr = Utilities.formatDate(new Date(), Session.getScriptTimeZone(), "yyyy-MM-dd");
  const formattedFillDate = formatDateStr(todayStr);

  // 按月份分组，一个月份工作表只调用一次 setValues，避免逐行 appendRow 拖慢速度
  const groupedByMonth = {};
  LEGACY_IMPORT_DATA.forEach(function(entry) {
    const venue = entry[0], unit = entry[1], useDate = entry[2];
    const monthKey = useDate.substring(0, 7);
    if (!groupedByMonth[monthKey]) groupedByMonth[monthKey] = [];
    const id = "ID_" + Utilities.getUuid();
    const formattedUseDate = formatDateStr(useDate);
    groupedByMonth[monthKey].push([
      id, venue, '联课团体例常活动', unit, '00:00', '23:59',
      '历史资料导入', formattedFillDate, formattedUseDate, timestamp
    ]);
  });

  let totalWritten = 0;
  const summaryLines = [];
  Object.keys(groupedByMonth).sort().forEach(function(monthKey) {
    const rows = groupedByMonth[monthKey];
    const sheet = getSheetForDate(monthKey + '-01'); // 复用现有逻辑：自动建表 + 表头 + 时间栏位纯文本格式
    sheet.getRange(sheet.getLastRow() + 1, 1, rows.length, HEADERS.length).setValues(rows);
    totalWritten += rows.length;
    summaryLines.push(monthKey + '：' + rows.length + ' 笔');
    Logger.log(monthKey + ' 写入 ' + rows.length + ' 笔');
  });

  // 写一笔汇总操作日志，不逐行记录（1000 笔逐行写日志会太慢也太乱）
  try {
    let auditSheet = ss.getSheetByName(AUDIT_SHEET_NAME);
    if (!auditSheet) {
      auditSheet = ss.insertSheet(AUDIT_SHEET_NAME);
      auditSheet.appendRow(['时间', '操作类型', '操作人邮箱', '记录ID', '场地', '活动', '单位', '时间段']);
      auditSheet.setFrozenRows(1);
      auditSheet.getRange("A1:H1").setFontWeight("bold");
    }
    auditSheet.appendRow([
      timestamp, '批量导入历史资料', operatorEmail, '(批量 ' + totalWritten + ' 笔)',
      '2026-07~09 联课团体场地', '联课团体例常活动', '(见各笔记录)', summaryLines.join('，')
    ]);
  } catch (e) {
    Logger.log('写入操作日志失败: ' + e.message);
  }

  Logger.log('✅ 导入完成，共写入 ' + totalWritten + ' 笔：' + summaryLines.join('，'));
  return { success: true, total: totalWritten, byMonth: groupedByMonth };
}
